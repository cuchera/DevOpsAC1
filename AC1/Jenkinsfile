def runCmd(String command) {
    if (isUnix()) {
        sh command
    } else {
        bat command
    }
}

def mvnw(String args) {
    dir('AC1') {
        if (isUnix()) {
            sh "chmod +x mvnw && ./mvnw ${args}"
        } else {
            bat "call .\\mvnw.cmd ${args}"
        }
    }
}

// Espera uma URL responder 200 (e, opcionalmente, conter um texto). 18 x 5s = 90s.
// Desafio 6: usada para health check de cada componente e para validar metricas.
def waitForUrl(String nome, String url) {
    waitForUrl(nome, url, '')
}

def waitForUrl(String nome, String url, String contem) {
    for (int i = 1; i <= 18; i++) {
        int rc
        if (isUnix()) {
            String filtro = contem ? " | grep -q '${contem}'" : ''
            rc = sh(returnStatus: true, script: "curl -sf ${url}${filtro}")
        } else {
            String teste = contem ? " -and \$r.Content -match '${contem}'" : ''
            rc = bat(returnStatus: true, script:
                'powershell -NoProfile -Command "try { $r = Invoke-WebRequest -UseBasicParsing ' + url +
                '; if ($r.StatusCode -eq 200' + teste + ') { exit 0 } else { exit 1 } } catch { exit 1 }"')
        }
        if (rc == 0) {
            echo "${nome} OK (tentativa ${i})"
            return
        }
        echo "Aguardando ${nome}... (${i}/18)"
        sleep 5
    }
    error("Verificacao falhou: ${nome} nao respondeu em 90s (${url})")
}

def waitForHealth(String port) {
    waitForUrl('Core Java', "http://localhost:${port}/actuator/health")
}

pipeline {
    agent any

    parameters {
        booleanParam(name: 'PUSH_DOCKER_HUB', defaultValue: false,
            description: 'Opcional: publicar a imagem no Docker Hub apos o build local.')
        booleanParam(name: 'RUN_E2E', defaultValue: false,
            description: 'Opcional: rodar Cypress E2E (exige servico cypress com profile e2e no compose).')
    }

    environment {
        DOCKER_IMAGE = 'ac1-app'
        DOCKER_CREDENTIALS_ID = 'dockerhub-credentials'
        IMAGE_TAG = "${BUILD_NUMBER}"
        COMPOSE_FILE = 'docker-compose.yml'
        API_PORT = '8081'
        PGADMIN_PORT = '5050'
        AI_PORT = '8001'
        PROMETHEUS_PORT = '9090'
        GRAFANA_PORT = '3000'
    }

    stages {
        stage('0 - Preflight do Ambiente') {
            steps {
                script {
                    echo "Plataforma Jenkins: ${isUnix() ? 'macOS/Linux (Unix)' : 'Windows'}"

                    echo '>>> [1/4] JAVA - verificando runtime usado pelo agente Jenkins'
                    timeout(time: 30, unit: 'SECONDS') {
                        runCmd('java -version')
                    }
                    echo '>>> [OK 1/4] JAVA'

                    echo '>>> [2/4] DOCKER CLI/ENGINE - verificando comunicacao cliente-servidor'
                    timeout(time: 60, unit: 'SECONDS') {
                        runCmd('docker version')
                    }
                    echo '>>> [OK 2/4] DOCKER CLI/ENGINE'

                    echo '>>> [3/4] DOCKER COMPOSE - verificando plugin Compose'
                    timeout(time: 30, unit: 'SECONDS') {
                        runCmd('docker compose version')
                    }
                    echo '>>> [OK 3/4] DOCKER COMPOSE'

                    echo '>>> [4/4] DOCKER ENGINE - verificando acesso completo ao daemon'
                    timeout(time: 60, unit: 'SECONDS') {
                        runCmd('docker info')
                    }
                    echo '>>> [OK 4/4] DOCKER ENGINE'

                    echo '>>> PREFLIGHT CONCLUIDO COM SUCESSO'
                }
            }
        }

        stage('1 - Checkout') {
            steps { checkout scm }
        }

        stage('2 - CI - JUnit + Testcontainers + JaCoCo') {
            steps {
                script {
                    // Inclui ParticipanteRepositoryTest com PostgreSQL real via Testcontainers.
                    mvnw('-B clean test')
                }
            }
            post {
                always {
                    junit testResults: 'AC1/target/surefire-reports/*.xml', allowEmptyResults: true
                    archiveArtifacts artifacts: 'AC1/target/site/jacoco/**', allowEmptyArchive: true
                }
            }
        }

        // Desafio 6: cobertura abaixo do minimo (pom.xml: jacoco.minimo) BLOQUEIA o deploy.
        stage('2.1 - Quality Gate - Cobertura JaCoCo') {
            steps { script { mvnw('-B jacoco:check') } }
        }

        stage('3 - CI - Qualidade PMD') {
            steps { script { mvnw('-B pmd:pmd -DskipTests') } }
            post {
                always { archiveArtifacts artifacts: 'AC1/target/site/pmd.html', allowEmptyArchive: true }
            }
        }

        stage('4 - CI - Package') {
            steps { script { mvnw('-B package -DskipTests') } }
        }

        stage('5 - CD - Build dos Containers') {
            steps { script { runCmd('docker compose -f ' + env.COMPOSE_FILE + ' build app ai-service') } }
        }

        stage('6 - Registry - Docker Hub (opcional)') {
            when { expression { return params.PUSH_DOCKER_HUB } }
            steps {
                withCredentials([usernamePassword(credentialsId: env.DOCKER_CREDENTIALS_ID,
                    usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASSWORD')]) {
                    script {
                        if (isUnix()) {
                            sh 'echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USER" --password-stdin'
                            sh "docker tag ${env.DOCKER_IMAGE}:latest \$DOCKER_USER/${env.DOCKER_IMAGE}:${env.IMAGE_TAG}"
                            sh "docker push \$DOCKER_USER/${env.DOCKER_IMAGE}:${env.IMAGE_TAG}"
                        } else {
                            bat 'echo %DOCKER_PASSWORD%| docker login -u %DOCKER_USER% --password-stdin'
                            bat "docker tag ${env.DOCKER_IMAGE}:latest %DOCKER_USER%/${env.DOCKER_IMAGE}:${env.IMAGE_TAG}"
                            bat "docker push %DOCKER_USER%/${env.DOCKER_IMAGE}:${env.IMAGE_TAG}"
                        }
                        runCmd('docker logout')
                    }
                }
            }
        }

        stage('7 - CD - Deploy HOMOL') {
            steps {
                script {
                    runCmd('docker compose -f ' + env.COMPOSE_FILE + ' down --remove-orphans')
                    runCmd('docker compose -f ' + env.COMPOSE_FILE + ' up -d postgres pgadmin ai-service mosquitto app prometheus grafana')
                }
            }
        }

        stage('8 - CD - Health Check HOMOL') {
            steps {
                script {
                    try {
                        waitForHealth(env.API_PORT)
                        waitForUrl('Servico de IA (Python)', "http://localhost:${env.AI_PORT}/health")
                    } catch (err) {
                        runCmd('docker compose -f ' + env.COMPOSE_FILE + ' ps')
                        runCmd('docker compose -f ' + env.COMPOSE_FILE + ' logs --tail=100 app')
                        throw err
                    }
                }
            }
        }

        // Desafio 6: o deploy so e considerado valido se a stack de observabilidade
        // esta no ar e cada componente expoe as metricas que sustentam os ADRs.
        stage('8.1 - Observabilidade - Prometheus, Grafana e metricas') {
            steps {
                script {
                    waitForUrl('Prometheus', "http://localhost:${env.PROMETHEUS_PORT}/-/ready")
                    waitForUrl('Grafana', "http://localhost:${env.GRAFANA_PORT}/api/health")
                    waitForUrl('Metricas do Core (ADR-004)',
                        "http://localhost:${env.API_PORT}/actuator/prometheus", 'ac1_notificacao_entregas_total')
                    waitForUrl('Metricas do servico de IA (ADR-003)',
                        "http://localhost:${env.AI_PORT}/metrics", 'http_request')
                }
            }
        }

        stage('9 - CD - Cypress E2E em Container') {
            when { expression { return params.RUN_E2E } }
            steps { script { runCmd('docker compose -f ' + env.COMPOSE_FILE + ' --profile e2e run --rm cypress') } }
            post {
                always {
                    archiveArtifacts artifacts: 'frontend/cypress/screenshots/*,frontend/cypress/videos/*', allowEmptyArchive: true
                }
            }
        }

        stage('10 - Observabilidade') {
            steps {
                echo "API: http://localhost:${API_PORT}"
                echo "Health: http://localhost:${API_PORT}/actuator/health"
                echo "pgAdmin: http://localhost:${PGADMIN_PORT}"
                echo "Prometheus (targets): http://localhost:${PROMETHEUS_PORT}/targets"
                echo "Grafana (admin/admin): http://localhost:${GRAFANA_PORT}/d/ac1-arquitetura"
            }
        }
    }

    post {
        success { echo 'Pipeline concluido: testes, quality gate, deploy HOMOL, health check e observabilidade aprovados.' }
        failure { echo 'Pipeline interrompido. Consulte o stage e os logs para identificar ambiente, teste ou servico responsavel.' }
       always {
           archiveArtifacts artifacts: 'AC1/target/site/jacoco/*,AC1/target/site/pmd.html,frontend/cypress/screenshots/,frontend/cypress/videos/*', allowEmptyArchive: true
       }
    }
}